# Supabase(PostgreSQL)の接続文字列。ローカル開発は DATABASE_URL/DIRECT_URLとも
# 「Session pooler」(ポート5432)でよい(1プロセスしか繋がないため)。
# 【本番(Vercel)では異なる値を使うこと】DATABASE_URLは
# 「Transaction pooler」(ポート6543)+ `?pgbouncer=true&connection_limit=1` を使う。
# サーバーレスは複数インスタンスが同時に起動しうるため、Session poolerだと
# 同時接続数の上限(このプランでは15)にすぐ達してエラーになる。
# 詳細は prisma/schema.prisma 冒頭のコメント、docs/PRODUCTION_PLAN.md を参照。
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:your-password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:your-password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# 本番公開時に必ず32文字以上のランダム文字列に変更(公開前チェックリスト参照)
SESSION_SECRET="please-generate-a-long-random-string"

# サイトの実URL(末尾スラッシュなし)。SEO(sitemap/robots/OGP/metadata)に使用。
# ローカルなら http://localhost:2000 、本番は https://o-school.site のように設定する。
SITE_URL="http://localhost:2000"

# 参加コード(生徒向け新規登録 & 時間割ゲート閲覧の共通の合言葉)の初期値。
# 管理画面(/admin/security)からDB上でいつでも変更でき、変更後はこの環境変数より
# DB側の値が優先される。この環境変数は「DBに一度も設定されていない場合」の
# フォールバックとしてのみ使われる(初回セットアップ用)。
SCHOOL_INVITE_CODE="please-set-a-real-invite-code"
